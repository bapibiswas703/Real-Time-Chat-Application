{
  "name": "codes-for-tomorrow-chat-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Secure 1:1 chat modular monolith",
  "engines": {
    "node": "^22.22.1"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "tsc-watch --noClear -p tsconfig.build.json --onSuccess \"npm run dev:serve\"",
    "dev:serve": "tsc-alias -p tsconfig.build.json && node dist/main.js",
    "start:dev": "npm run dev",
    "build:watch": "tsc-watch --noClear -p tsconfig.build.json --onSuccess \"tsc-alias -p tsconfig.build.json\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test prisma.config.ts",
    "format": "prettier --write src test docs *.json *.cjs *.ts *.md .github/**/*.yml",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --coverage",
    "test:integration": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.integration.config.cjs --runInBand",
    "test:redis": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.integration.config.cjs --runInBand --runTestsByPath test/integration/redis-rate-limit.spec.ts",
    "test:smoke": "node test/compiled-smoke.cjs",
    "firebase:check": "node test/firebase-cloud-check.cjs",
    "security:scan": "node --test test/secret-scan.spec.cjs && node test/secret-scan.cjs",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-chat",
    "test:emulators": "firebase emulators:exec --only auth,firestore --project demo-chat \"npm run test:integration\""
  },
  "dependencies": {
    "@nestjs/common": "12.3.2",
    "@nestjs/core": "12.3.2",
    "@nestjs/platform-express": "12.3.2",
    "@nestjs/platform-socket.io": "12.3.2",
    "@nestjs/swagger": "12.0.5",
    "@nestjs/websockets": "12.3.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@socket.io/redis-adapter": "^8.3.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^17.2.0",
    "firebase-admin": "14.5.0",
    "helmet": "^8.1.0",
    "pg": "^8.16.3",
    "redis": "6.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "4.8.4"
  },
  "devDependencies": {
    "@babel/plugin-transform-modules-commonjs": "^7.29.7",
    "@eslint/js": "10.0.1",
    "@nestjs/testing": "12.3.2",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.18.0",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^6.0.3",
    "babel-jest": "^30.2.0",
    "eslint": "10.13.0",
    "firebase-tools": "15.34.1",
    "jest": "^30.2.0",
    "prettier": "^3.6.2",
    "prisma": "7.10.1",
    "socket.io-client": "4.8.4",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.5",
    "tsc-alias": "1.9.9",
    "tsc-watch": "7.2.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0"
  },
  "overrides": {
    "@opentelemetry/core": "^2.12.0",
    "uuid": "^11.1.1",
    "re2": "^1.27.0"
  }
}
