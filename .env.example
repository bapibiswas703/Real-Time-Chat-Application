NODE_ENV=development
PORT=3000
# Run from the project root with native PostgreSQL/Redis and live Firebase.
# Replace the PostgreSQL password placeholder; URL-encode special characters.
DATABASE_URL=postgresql://postgres:your_postgresql_password@127.0.0.1:5432/chat
# Loopback development service. Use authentication and TLS for deployment.
REDIS_URL=redis://127.0.0.1:6379
# Optional Docker Compose credentials; unused by native local services.
POSTGRES_PASSWORD=your_postgresql_password
REDIS_PASSWORD=
FIREBASE_PROJECT_ID=real-time-chat-applicati-a640f
# Copy your private Admin SDK JSON here locally; Git and Docker exclude it.
GOOGLE_APPLICATION_CREDENTIALS=./firebase-adminsdk.json
CORS_ORIGINS=http://localhost:5173
HTTP_RATE_LIMIT=120
SOCKET_RATE_LIMIT=120
TYPING_RATE_LIMIT=10
SWAGGER_ENABLED=true
# Do not set emulator variables when using this live-Firebase profile.
# Isolated integration configuration: docs/testing/test-strategy.md.
# Deployment: inject credentials externally or use workload identity;
# never package firebase-adminsdk.json in an image or commit it.
